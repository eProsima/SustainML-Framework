{
    "_comment": [
        "Icons of src/images/icons drawn from the Lucide masters in thirdparty/lucide/icons.",
        "icons: SustainML icon name -> Lucide master. 'fill' fills the shape with the variant colour",
        "instead of only stroking it.",
        "variants: variant suffix -> colour. Every icon gets every variant (see style/icons.md);",
        "Theme.icon* picks the right one for the current theme."
    ],
    "strokeWidth": 2,
    "variants": {
        "dark": "#15201A",
        "light": "#E4EAE5",
        "muted": "#6F7B72",
        "accent": "#21780A",
        "accent_dark": "#9BE070",
        "white": "#FFFFFF",
        "danger": "#B91C1C",
        "danger_dark": "#F87171",
        "warning": "#A44B07",
        "warning_dark": "#FBBF24",
        "success": "#11652F",
        "success_dark": "#4ADE80"
    },
