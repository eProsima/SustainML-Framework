<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sustainml</name>
  <version>0.2.0</version>
  <description>
    Qt application written in C++ that acts as a frontend for the SustainML project.
  </description>
  <maintainer email="RaulSanchezMateos@eprosima.com">Raul Sánchez-Mateos</maintainer>
  <maintainer email="mariodominguez@eprosima.com">Mario Domínguez</maintainer>
  <maintainer email="javiergil@eprosima.com">Javier Gil</maintainer>
  <license file="LICENSE">GNU general public license</license>

  <url type="website">https://sustainml.eu/</url>
  <url type="bugtracker">https://github.com/eProsima/SustainML-Framework/issues</url>
  <url type="repository">https://github.com/eProsima/SustainML-Framework</url>

  <depend>fastcdr</depend>
  <depend>fastdds</depend>
  <depend>dev-utils</depend>
  <depend>cmake_utils</depend>
  <depend>sustainml_cpp</depend>

  <buildtool_depend>cmake</buildtool_depend>

  <export>
    <build_type>cmake</build_type>
  </export>
</package>
